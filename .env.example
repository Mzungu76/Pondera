# Copy to .env for local development. NEVER commit .env.
# Server-side only (Netlify Functions). Never prefix these with VITE_.

# Required. Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=

# Required. Model id used for every analysis stage. Not hardcoded in the app.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. If set, AI analysis requires this shared code (beta protection only).
PONDERA_ACCESS_CODE=

# Optional tuning
# ANTHROPIC_TIMEOUT_MS=50000
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages   (override for tests only)
# PONDERA_RATE_LIMIT_MAX=30   (requests per client per 10 min; one analysis = 6 requests)
